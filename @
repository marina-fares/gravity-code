services:

  app:
    build: ./backend
    image: "backend-app"
    container_name: "backend-app"
    tty: true
    stdin_open: true
    networks:
      gravity_default:
    volumes:
      - ./backend:/usr/src/app
      - ./backend/django-static:/usr/src/app/django-static 
      - backend-pips-dir:/usr/local/lib/python3.9/site-packages:delegated
    ports:
      - 5000:5000
    environment:
      VIRTUAL_HOST: "app.gravity.com"
      HOST: "app.gravity.com"
      PORT: 5000
      HISTFILE: /usr/src/app/src/logs/.bash_history.log
    deploy:
      resources:
        limits:
          memory: 512M   # memory limit لتجنب swap explosion
    command: >
      gunicorn project.wsgi:application
      --bind 0.0.0.0:5000
      --workers 2
      --max-requests 500
      --max-requests-jitter 100
      --timeout 30
      --log-level info
      --access-logfile /usr/src/app/src/logs/gunicorn-access.log
      --error-logfile /usr/src/app/src/logs/gunicorn-error.log

volumes:
  backend-pips-dir:

networks:
  gravity_default:
    driver: bridge

