[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = "==4.1"
django-extensions = "*"
djangorestframework = "*"
python-dotenv = ">=1.0"          # was django-dotenv (wrong package) — lock file still has old version
markdown = "*"
django-filter = "*"
requests = "*"
psycopg2-binary = "*"
drf-yasg = "*"
djangorestframework-simplejwt = "*"
django-cors-headers = "*"
django-admin-rangefilter = "*"
django-crontab = "*"
typing-extensions = ">=4.6"     # was >=4.0 — Django 4.1 + asgiref 3.8 needs at least 4.6
gunicorn = "==21.2.0"           # ADD — must be in Pipfile so pipenv lock captures it
whitenoise = ">=6.6"
[requires]
python_version = "3.9"

[pipenv]
allow_prereleases = true
